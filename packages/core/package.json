{
  "name": "@orrery/core",
  "version": "0.0.0",
  "private": true,
  "description": "Orrery domain model, event union, config schema, and metaphor map.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/orrery.config.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-json-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
