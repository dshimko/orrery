{
  "name": "@orrery/server",
  "version": "0.0.0",
  "private": true,
  "description": "Config loading, adapter registry, snapshot and SSE API.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=source src/main.ts"
  },
  "dependencies": {
    "@orrery/adapter-mock": "workspace:*",
    "@orrery/core": "workspace:*",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@orrery/testkit": "workspace:*",
    "tsx": "4.23.15"
  }
}
